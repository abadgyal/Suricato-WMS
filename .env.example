# Configuración de Supabase para el frontend.
# Copia este fichero a `.env` y rellena los valores de tu proyecto.
# NUNCA pongas aquí (ni en .env) la service_role / sb_secret_...: solo la clave
# publishable/anon, que es pública por diseño y está protegida por RLS.

# URL del proyecto Supabase (ej. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave publishable / anon del proyecto (Project Settings → API)
VITE_SUPABASE_PUBLISHABLE_KEY=
